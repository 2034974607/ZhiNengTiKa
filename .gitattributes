* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.py text eol=lf
*.md text eol=lf
gradlew text eol=lf
# Keep the official Windows wrapper byte layout and recognize CRLF as line endings.
gradlew.bat -text whitespace=cr-at-eol
*.jar binary
# Bundled legal documents retain the exact upstream bytes and their recorded hashes.
app/src/main/assets/legal/*.txt -text -whitespace
docs/debug-test-notices.txt -text -whitespace
